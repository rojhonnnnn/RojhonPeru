# ROJHON SOLUTIONS - chat attachments
# Files here are only served through module/chat/api.php?act=file, which
# checks that you are part of the conversation. Direct access is blocked,
# and nothing in this folder may ever run as a script.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
